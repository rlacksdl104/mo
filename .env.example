# Copy this file to .env.local and fill with your real keys
# PortOne (아임포트) channel key used for IMP.init
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=your_portone_channel_key_here
# Optional: specify PG code if your PortOne 채널에 특정 PG만 연결되어 있는 경우
# 예: kakaopay, html5_inicis, nice, etc.
NEXT_PUBLIC_PORTONE_PG=kakaopay
# Optional: default payment method
NEXT_PUBLIC_PORTONE_PAY_METHOD=card

# Toss Payments keys
NEXT_PUBLIC_TOSS_CLIENT_KEY=your_toss_client_key_here
TOSS_SECRET_KEY=your_toss_secret_key_here

# API server base (optional override)
# When deployed to Vercel with the proxy rewrite, set this to /api/proxy
# so the browser uses HTTPS and Vercel forwards requests to the HTTP backend.
NEXT_PUBLIC_API_URL=http://13.208.243.83:8080
